<UserControl x:Class="TapeKhashDesktop.Views.AppSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#19768C" Padding="16">
            <Grid>
                <TextBlock x:Name="WelcomeText" Foreground="White" FontSize="16" VerticalAlignment="Center" />
                <Button x:Name="LogoutButton" Content="خروج" HorizontalAlignment="Left" Click="OnLogoutClick" />
            </Grid>
        </Border>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <TextBlock Text="کدام برنامه را می‌خواهید باز کنید؟" FontSize="16" Margin="0,0,0,20" HorizontalAlignment="Center" />

            <Button x:Name="TapeButton" Height="70" Click="OnOpenTape">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="28" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="مدیریت تپه‌ها" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="ثبت، جستجو، برداشت و برگشت تپه‌ها" FontSize="11" Foreground="Gray" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="KhashButton" Height="70" Margin="4,16,4,4" Click="OnOpenKhash">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧾" FontSize="28" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="مدیریت فاکتور خاش" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="فاکتورها، پرداخت‌ها، سفارشات و گزارش‌ها" FontSize="11" Foreground="Gray" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <TextBlock x:Name="NoAccessText" Foreground="Red" TextWrapping="Wrap" Margin="4,16,4,4" Visibility="Collapsed"
                       Text="شما به هیچ برنامه‌ای دسترسی ندارید. با مدیر سیستم تماس بگیرید." />
        </StackPanel>
    </DockPanel>
</UserControl>
