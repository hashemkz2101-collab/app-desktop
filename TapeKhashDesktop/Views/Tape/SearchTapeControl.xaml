<UserControl x:Class="TapeKhashDesktop.Views.Tape.SearchTapeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox x:Name="QueryBox" Width="260" KeyDown="QueryBox_KeyDown" />
            <Button Content="جستجو" Click="OnSearchClick" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Red" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" Foreground="Green" TextWrapping="Wrap" />

        <ListBox x:Name="ResultsList" BorderThickness="0" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Tape, StringFormat='تپه: {0}'}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Box, StringFormat='باکس: {0}'}" />
                                <TextBlock Text="{Binding Status, StringFormat='وضعیت: {0}'}" />
                                <TextBlock Text="{Binding HolderName, StringFormat='در اختیار: {0}'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="برداشت" Click="OnTakeClick" />
                                <Button Content="برگشت" Click="OnReturnClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
