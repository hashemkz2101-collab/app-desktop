<Window x:Class="TapeKhashDesktop.Views.Tape.EditTapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویرایش تپه" Height="280" Width="340" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBox x:Name="BoxCodeBox" />
        <TextBlock Text="کد باکس" Foreground="Gray" FontSize="11" Margin="8,-2,0,8" />
        <TextBox x:Name="TapeCodeBox" />
        <TextBlock Text="کد تپه" Foreground="Gray" FontSize="11" Margin="8,-2,0,8" />
        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="4,8,4,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="ذخیره" Click="OnSaveClick" />
            <Button Content="انصراف" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
