<UserControl x:Class="TapeKhashDesktop.Views.Tape.EditTapeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox x:Name="QueryBox" Width="220" />
            <Button Content="جستجو" Click="OnSearchClick" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Red" TextWrapping="Wrap" />
        <ListBox x:Name="List" BorderThickness="0" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Tape, StringFormat='تپه: {0}'}" />
                                <TextBlock Text="{Binding Box, StringFormat='باکس: {0}'}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="ویرایش" Click="OnEditClick" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
