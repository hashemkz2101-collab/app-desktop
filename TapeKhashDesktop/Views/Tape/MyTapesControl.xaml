<UserControl x:Class="TapeKhashDesktop.Views.Tape.MyTapesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" x:Name="TitleText" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Red" TextWrapping="Wrap" />
        <ListBox x:Name="ResultsList" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Tape, StringFormat='تپه: {0}'}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Box, StringFormat='باکس: {0}'}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="برگشت" Click="OnReturnClick" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
