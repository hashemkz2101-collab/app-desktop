<UserControl x:Class="TapeKhashDesktop.Views.Tape.TapeMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#19768C" Padding="12">
            <Grid>
                <TextBlock Text="مدیریت تپه‌ها" Foreground="White" FontSize="16" VerticalAlignment="Center" />
                <Button Content="بازگشت" HorizontalAlignment="Left" Click="OnBackClick" />
            </Grid>
        </Border>
        <TabControl x:Name="Tabs">
            <TabItem Header="جستجو"><local:SearchTapeControl xmlns:local="clr-namespace:TapeKhashDesktop.Views.Tape" /></TabItem>
            <TabItem Header="تپه‌های من"><local:MyTapesControl xmlns:local="clr-namespace:TapeKhashDesktop.Views.Tape" /></TabItem>
            <TabItem Header="ثبت تپه"><local:AddTapeControl xmlns:local="clr-namespace:TapeKhashDesktop.Views.Tape" /></TabItem>
            <TabItem x:Name="AdminTab" Header="مدیریت" Visibility="Collapsed">
                <local:AdminTapeView xmlns:local="clr-namespace:TapeKhashDesktop.Views.Tape" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
