<UserControl x:Class="TapeKhashDesktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
            <TextBlock Text="ورود به سامانه" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" HorizontalAlignment="Center" />

            <TextBox x:Name="UsernameBox" />
            <TextBlock Text="نام کاربری" Foreground="Gray" FontSize="11" Margin="8,-2,0,0" />

            <PasswordBox x:Name="PasswordBox" Margin="4,8,4,0" />
            <TextBlock Text="رمز عبور" Foreground="Gray" FontSize="11" Margin="8,-2,0,0" />

            <CheckBox x:Name="RememberCheck" Content="مرا به خاطر بسپار" IsChecked="True" Margin="4,12,4,0" />

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="4,8,4,0" />
            <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" Margin="4,4,4,0" />

            <Button Content="ورود" Click="OnLoginClick" Margin="4,16,4,0" Height="36" />

            <Expander Header="تنظیمات آدرس سرور" Margin="4,20,4,0">
                <StackPanel>
                    <TextBox x:Name="BaseUrlBox" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
