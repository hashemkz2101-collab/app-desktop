<UserControl x:Class="TapeKhashDesktop.Views.Khash.PaymentsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer>
        <StackPanel Margin="16">
            <TextBlock Text="ثبت پرداخت به نیرو" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />

            <ComboBox x:Name="EmployeeCombo" />
            <TextBlock Text="نیرو" Foreground="Gray" FontSize="11" Margin="8,-2,0,8" />

            <TextBox x:Name="AmountBox" />
            <TextBlock Text="مبلغ" Foreground="Gray" FontSize="11" Margin="8,-2,0,8" />

            <TextBox x:Name="DateBox" />
            <TextBlock Text="تاریخ شمسی (خالی = امروز)" Foreground="Gray" FontSize="11" Margin="8,-2,0,8" />

            <TextBox x:Name="DescriptionBox" />
            <TextBlock Text="توضیحات" Foreground="Gray" FontSize="11" Margin="8,-2,0,8" />

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="4,8,4,0" />
            <TextBlock x:Name="MessageText" Foreground="Green" TextWrapping="Wrap" Margin="4,4,4,0" />

            <Button Content="ثبت پرداخت" Click="OnSubmitClick" Height="36" Margin="4,12,4,0" />

            <Separator Margin="0,20,0,12" />
            <TextBlock Text="پرداخت‌های اخیر" FontWeight="Bold" FontSize="15" />
            <ItemsControl x:Name="List" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,3">
                            <TextBlock Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
