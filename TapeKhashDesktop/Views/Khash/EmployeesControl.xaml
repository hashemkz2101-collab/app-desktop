<UserControl x:Class="TapeKhashDesktop.Views.Khash.EmployeesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="نیروها و مانده حساب" FontWeight="Bold" FontSize="15" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBox x:Name="NewNameBox" Width="140" />
                <Button Content="+ نیروی جدید" Click="OnAddClick" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Foreground="Red" TextWrapping="Wrap" />
        <ListBox x:Name="List" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Summary}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
